# Required for the server-verified admin login at /admin.
# Use a unique passcode and a randomly generated secret of at least 32 characters.
ADMIN_PASSCODE=
ADMIN_SESSION_SECRET=

# Supabase Google OAuth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use this instead if your Supabase project provides an anon key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lowercase aliases are also supported for deployments that already use these names:
# admin_passcode=
# admin_session_secret=
